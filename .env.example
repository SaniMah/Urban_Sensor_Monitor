# Copy this file to ".env" and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# --- PostgreSQL connection (Neon or Supabase) ---
# SQLAlchemy URL format:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# You can reuse your existing Neon project with new tables, or make a new one.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/factorypulse

# --- City of Melbourne open data (Socrata) ---
# An app token is OPTIONAL but lifts rate limits. Get one (free) at
# https://data.melbourne.vic.gov.au  ->  profile -> developer settings.
MELBOURNE_APP_TOKEN=

# --- LLM API (Step: AI weekly report) ---
# Only needed later; a local model (Ollama) can be used instead with no key.
ANTHROPIC_API_KEY=your-key-here
