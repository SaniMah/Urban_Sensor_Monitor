# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# --- PostgreSQL connection (Neon or Supabase) ---
# SQLAlchemy URL format:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/urbansensormonitor

# --- City of Melbourne open data (Socrata) ---
# Optional app token; lifts API rate limits. Free from the open-data portal.
MELBOURNE_APP_TOKEN=

# --- LLM API (optional) ---
# Not required; a local model (Ollama) works with no key.
ANTHROPIC_API_KEY=
